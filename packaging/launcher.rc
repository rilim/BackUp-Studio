#include <winresrc.h>
1 RT_MANIFEST "launcher.manifest"
1 ICON "app.ico"
1 VERSIONINFO
FILEVERSION 2,6,0,0
PRODUCTVERSION 2,6,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "BackUp Studio – Portable Windows x64\0"
      VALUE "FileVersion", "2.6.0.0\0"
      VALUE "InternalName", "BackUpStudio\0"
      VALUE "OriginalFilename", "BackUpStudio.exe\0"
      VALUE "ProductName", "BackUp Studio\0"
      VALUE "ProductVersion", "2.6.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
